<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account_reports_community_v2.AccountReportAction">
        <div class="o_action o_account_reports_community_v2">
            <Layout display="this.display">
                <div class="o_account_reports_community_v2_page" t-if="this.state.report" t-on-click="this.onPageClick">
                    <div class="o_account_reports_community_v2_toolbar d-flex align-items-center gap-3 flex-wrap px-3 py-2 border-bottom">
                        <input t-if="!this.isPartnerBasedReport"
                               type="text" class="o_account_reports_community_v2_search" t-att-placeholder="this.searchPlaceholder"
                               t-on-input="this.onSearchInput"/>

                        <span t-if="this.isPartnerBasedReport" class="position-relative">
                            <button class="btn btn-secondary btn-sm" t-on-click="this.togglePartnerMenu">
                                <i class="oi oi-fw me-1" data-icon="group"/><t t-out="this.partnerFilterLabel"/>
                            </button>
                            <div t-if="this.state.partnerMenuOpen"
                                 class="o_account_reports_community_v2_menu o_account_reports_community_v2_menu_scrollable dropdown-menu show position-absolute p-2">
                                <input type="text" class="o_account_reports_community_v2_search mb-2" placeholder="Filter partners..."
                                       t-on-input="this.onPartnerFilterQueryInput"/>
                                <div t-foreach="this.filteredAvailablePartners" t-as="partner" t-key="partner.id"
                                     class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="this.state.partnerIds.includes(partner.id)"
                                           t-on-change="() => this.togglePartnerFilter(partner.id)"/>
                                    <label class="form-check-label" t-out="partner.name"/>
                                </div>
                            </div>
                        </span>

                        <span class="position-relative">
                            <button class="btn btn-secondary btn-sm" t-on-click="this.togglePresetMenu">
                                <i class="oi oi-fw me-1" data-icon="calendar_today"/>Period
                            </button>
                            <div t-if="this.state.presetMenuOpen"
                                 class="o_account_reports_community_v2_menu dropdown-menu show position-absolute">
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('today')">Today</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('this_month')">This Month</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('last_month')">Last Month</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('this_quarter')">This Quarter</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('last_quarter')">Last Quarter</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('this_year')">This Year</a>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.applyDatePreset('last_year')">Last Year</a>
                            </div>
                        </span>

                        <div class="d-flex align-items-center gap-1">
                            <label t-if="this.state.report.report_handler !== 'aged_partner_balance'" class="mb-0 text-muted">From</label>
                            <input t-if="this.state.report.report_handler !== 'aged_partner_balance'"
                                   type="date" class="o_account_reports_community_v2_date" t-att-value="this.state.dateFrom" t-on-change="this.onDateFromChange"/>
                            <label class="mb-0 text-muted">
                                <t t-out="this.state.report.report_handler === 'aged_partner_balance' ? 'As of' : 'To'"/>
                            </label>
                            <input type="date" class="o_account_reports_community_v2_date" t-att-value="this.state.dateTo" t-on-change="this.onDateToChange"/>
                        </div>

                        <span class="position-relative">
                            <button class="btn btn-secondary btn-sm" t-on-click="this.toggleJournalMenu">
                                <i class="oi oi-fw me-1" data-icon="menu_book"/><t t-out="this.journalFilterLabel"/>
                            </button>
                            <div t-if="this.state.journalMenuOpen"
                                 class="o_account_reports_community_v2_menu dropdown-menu show position-absolute p-2">
                                <div t-foreach="this.state.availableJournals" t-as="journal" t-key="journal.id"
                                     class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="this.state.journalIds.includes(journal.id)"
                                           t-on-change="() => this.toggleJournal(journal.id)"/>
                                    <label class="form-check-label" t-out="journal.name"/>
                                </div>
                            </div>
                        </span>

                        <span t-if="this.state.availableCurrencies.length > 1" class="position-relative">
                            <button class="btn btn-secondary btn-sm" t-on-click="this.toggleCurrencyMenu">
                                <i class="oi oi-fw me-1" data-icon="payments"/><t t-out="this.currencyFilterLabel"/>
                            </button>
                            <div t-if="this.state.currencyMenuOpen"
                                 class="o_account_reports_community_v2_menu dropdown-menu show position-absolute">
                                <a t-foreach="this.state.availableCurrencies" t-as="currency" t-key="currency.id"
                                   href="#" class="dropdown-item"
                                   t-att-class="{ active: this.state.currencyId === currency.id }"
                                   t-on-click.prevent="() => this.selectCurrency(currency.id)"
                                   t-out="currency.name"/>
                            </div>
                        </span>

                        <button class="btn btn-secondary btn-sm" t-on-click="this.toggleAllEntries">
                            <i class="oi oi-fw me-1" data-icon="filter_list"/>
                            <t t-out="this.state.allEntries ? 'All Entries' : 'Posted Entries'"/>
                        </button>

                        <button class="btn btn-secondary btn-sm" t-on-click="this.toggleUnfoldAll">
                            <i class="oi oi-fw me-1" t-att-data-icon="this.state.unfoldAll ? 'unfold_less' : 'unfold_more'"/>
                            <t t-out="this.state.unfoldAll ? 'Fold All' : 'Unfold All'"/>
                        </button>

                        <button t-if="!this.state.report.report_handler || this.state.report.report_handler === 'generic'"
                                class="btn btn-sm"
                                t-att-class="this.state.comparisonEnabled ? 'btn-primary' : 'btn-secondary'"
                                t-on-click="this.toggleComparison">
                            <i class="oi oi-fw me-1" data-icon="percent"/>Comparison
                        </button>

                        <i t-if="this.state.isLoading" class="oi oi-spin ms-2 text-muted" data-icon="autorenew" title="Loading..."/>

                        <span class="ms-auto d-flex gap-2">
                            <button class="btn btn-secondary btn-sm" t-on-click="this.exportPdf">
                                <i class="oi oi-fw me-1" data-icon="picture_as_pdf"/>PDF
                            </button>
                            <button class="btn btn-secondary btn-sm" t-on-click="this.exportXlsx">
                                <i class="oi oi-fw me-1" data-icon="table_view"/>Excel
                            </button>
                        </span>
                    </div>

                    <div t-if="this.state.report.has_unposted_entries" class="alert alert-info mb-0 rounded-0 py-2 text-center">
                        There are unposted Journal Entries prior or included in this period.
                    </div>

                    <div class="container-fluid">
                        <h4 class="mt-3 mb-3" t-out="this.state.report.report_name"/>

                        <table t-if="!this.state.report.report_handler || this.state.report.report_handler === 'generic'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr t-if="this.state.report.periods.length > 1">
                                    <th/>
                                    <t t-foreach="this.state.report.periods" t-as="period" t-key="period_index">
                                        <th class="text-center" t-att-colspan="this.state.report.columns.length" t-out="period.label"/>
                                    </t>
                                </tr>
                                <tr>
                                    <th>Name</th>
                                    <t t-foreach="this.state.report.periods" t-as="period" t-key="period_index">
                                        <t t-foreach="this.state.report.columns" t-as="column" t-key="column.expression_label">
                                            <th class="text-end" t-out="column.name"/>
                                        </t>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.ReportLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <table t-elif="this.state.report.report_handler === 'general_ledger'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Journal Entry</th>
                                    <th>Partner</th>
                                    <th>Label</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.GeneralLedgerLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <table t-elif="this.state.report.report_handler === 'partner_ledger'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Journal Entry</th>
                                    <th>Account</th>
                                    <th>Label</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.PartnerLedgerLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <table t-elif="this.state.report.report_handler === 'aged_partner_balance'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <t t-foreach="this.state.report.bucket_columns" t-as="bucket" t-key="bucket.key">
                                        <th class="text-end" t-out="bucket.label"/>
                                    </t>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.AgedPartnerBalanceLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <table t-elif="this.state.report.report_handler === 'tax_report'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr>
                                    <th>Tax</th>
                                    <th class="text-end">Base Amount</th>
                                    <th class="text-end">Tax Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.TaxReportLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <table t-elif="this.state.report.report_handler === 'journal_report'"
                               class="table table-sm table-hover o_account_reports_community_v2_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Journal Entry</th>
                                    <th>Account</th>
                                    <th>Label</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-call="account_reports_community_v2.JournalReportLines" lines="this.state.report.lines"/>
                            </tbody>
                        </table>

                        <div t-else="" class="text-center p-4 text-muted">
                            Unknown report handler: <t t-out="this.state.report.report_handler"/>
                        </div>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <t t-name="account_reports_community_v2.ReportLines">
        <t t-foreach="lines || []" t-as="line" t-key="line.id">
            <tr>
                <td t-attf-style="padding-left: {{line.level * 16}}px">
                    <span t-if="line.foldable"
                          class="o_account_reports_community_v2_caret"
                          t-att-title="line.unfolded ? 'Collapse' : 'Expand'"
                          t-on-click="() => this.toggleLine(line)">
                        <i class="oi oi-fw" t-att-data-icon="line.unfolded ? 'arrow_drop_down' : 'arrow_right'"/>
                    </span>
                    <span t-if="line.foldable"
                          class="cursor-pointer fw-semibold"
                          t-att-title="line.unfolded ? 'Collapse' : 'Expand'"
                          t-on-click="() => this.toggleLine(line)"
                          t-out="line.name"/>
                    <t t-elif="line.account_id">
                        <a href="#" class="text-decoration-none text-body" title="View Account" t-on-click.prevent="() => this.onOpenAccount(line)" t-out="line.name"/>
                    </t>
                    <t t-else="" t-out="line.name"/>
                    <span t-if="line.account_id" class="o_account_reports_community_v2_kebab_wrapper position-relative ms-1">
                        <span class="o_account_reports_community_v2_kebab" t-on-click.stop="() => this.toggleMenu(line)" title="More Options">
                            <i class="oi oi-fw" data-icon="more_vert"/>
                        </span>
                        <div t-if="this.state.openMenuLineId === line.id"
                             class="o_account_reports_community_v2_menu dropdown-menu show position-absolute">
                            <a href="#" class="dropdown-item" title="Open General Ledger for this account" t-on-click.prevent="() => this.onOpenGeneralLedger(line)">
                                General Ledger
                            </a>
                            <a href="#" class="dropdown-item" title="View all journal items for this account" t-on-click.prevent="() => this.onOpenJournalItems(line)">
                                Journal Items
                            </a>
                        </div>
                    </span>
                </td>
                <t t-foreach="line.periods" t-as="period" t-key="period_index">
                    <t t-foreach="period.columns" t-as="column" t-key="column.expression_label">
                        <td class="text-end o_account_reports_community_v2_cell"
                            t-on-click="() => this.onCellClick(line, column, period)"
                            t-out="column.value != null ? this.formatAmount(column.value) : ''"/>
                    </t>
                </t>
            </tr>
            <t t-if="line.unfolded &amp;&amp; line.children &amp;&amp; line.children.length" t-call="account_reports_community_v2.ReportLines" lines="line.children"/>
        </t>
    </t>

    <!--
        General Ledger's, Partner Ledger's, and Aged Receivable/Payable's
        row templates (account_reports_community_v2.GeneralLedgerLines,
        .PartnerLedgerLines, .AgedPartnerBalanceLines) live in
        general_ledger_table.xml, partner_ledger_table.xml, and
        aged_balance_table.xml respectively - split out purely for file
        size/readability. t-call resolves templates by name across the
        whole bundle regardless of which file registers them, so this is a
        no-op for runtime behavior; it just keeps this file down to the
        shell + the generic (Trial Balance/Balance Sheet/P&L) case.
    -->

</templates>
